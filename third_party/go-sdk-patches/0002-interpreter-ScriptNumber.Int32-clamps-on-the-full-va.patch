From 15dd3acdf154ddb0ec276c1d4b4f6609cabfdcb7 Mon Sep 17 00:00:00 2001
From: Freddie Honohan <honohanf@gmail.com>
Date: Thu, 8 Oct 2026 23:31:45 +0100
Subject: [PATCH 2/2] interpreter: ScriptNumber.Int32 clamps on the full value

Int32 clamped big.Int's Int64, which already keeps only the low 64 bits of a wider number, so a wide
OP_SPLIT position could pass the bounds check and then panic on the slice (2^63), or split at the wrong
place (2^64+1), and OP_PICK / OP_ROLL at 2^64 picked the top item. Int32 now clamps through Int64, which
compares the whole number (Int keeps its documented truncation; its callers check the range first).
ts-sdk Spend refuses all of these.

Found by b017-native's interpreter differential (seed 103).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Rkfed16fxRUgKofZPqhvxT
---
 script/interpreter/number.go          | 2 +-
 script/interpreter/wide_count_test.go | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/script/interpreter/number.go b/script/interpreter/number.go
index 6fcedac..0fd51eb 100644
--- a/script/interpreter/number.go
+++ b/script/interpreter/number.go
@@ -250,7 +250,7 @@ func (n *ScriptNumber) Int() int {
 // out of range before being reinterpreted as an integer, this will provide the
 // correct behavior.
 func (n *ScriptNumber) Int32() int32 {
-	v := n.Val.Int64()
+	v := n.Int64() // clamped: big.Int's Int64 keeps only the low 64 bits of a wider number
 	if v > math.MaxInt32 {
 		return math.MaxInt32
 	}
diff --git a/script/interpreter/wide_count_test.go b/script/interpreter/wide_count_test.go
index e40a571..9d47a5c 100644
--- a/script/interpreter/wide_count_test.go
+++ b/script/interpreter/wide_count_test.go
@@ -28,6 +28,12 @@ func TestWideCountsAreNotTruncated(t *testing.T) {
 		{"OP_RSHIFT by 2^63 gives zeros", "0107" + "09000000000000008000" + "99" + "0100" + "87", ""},
 		// 2^64 keys is too many (the low 64 bits read as 0 keys)
 		{"OP_CHECKMULTISIG with 2^64 keys fails", "00" + "00" + "09000000000000000001" + "ae", "too many pubkeys"},
+		// 2^63 as a split position (the low 64 bits are negative: the slice panicked)
+		{"OP_SPLIT at 2^63 fails", "03616263" + "09000000000000008000" + "7f" + "7551", "n is larger than length of array"},
+		// 2^64 + 1 (the low 64 bits are 1: the split went ahead)
+		{"OP_SPLIT at 2^64+1 fails", "03616263" + "09010000000000000001" + "7f" + "7551", "n is larger than length of array"},
+		// 2^64 (the low 64 bits are 0: the top item was picked)
+		{"OP_PICK at 2^64 fails", "51" + "09000000000000000001" + "79", "index"},
 	}
 	for _, tt := range tests {
 		tt := tt
