From 26e7853ec7f71d7b433f536dc9aab7d18d14c299 Mon Sep 17 00:00:00 2001
From: Freddie Honohan <honohanf@gmail.com>
Date: Thu, 8 Oct 2026 22:36:21 +0100
Subject: [PATCH 1/2] interpreter: judge shift and multisig counts by their
 full value

ScriptNumber.Int keeps only the low 64 bits. After Chronicle a script number can be much wider, so
OP_LSHIFT / OP_RSHIFT read a count of 2^63 as negative (an error) and 2^64+1 as a shift by 1, and
OP_CHECKMULTISIG read 2^64 keys as 0. ts-sdk Spend compares the whole number: a shift past every bit
leaves zeros of the input's width, and an out-of-range key or signature count is an error.

Found by b017-native's interpreter differential against ts-sdk.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Rkfed16fxRUgKofZPqhvxT
---
 script/interpreter/operations.go      | 37 ++++++++++++++++----
 script/interpreter/wide_count_test.go | 49 +++++++++++++++++++++++++++
 2 files changed, 80 insertions(+), 6 deletions(-)
 create mode 100644 script/interpreter/wide_count_test.go

diff --git a/script/interpreter/operations.go b/script/interpreter/operations.go
index 1fa1f35..7d84bca 100644
--- a/script/interpreter/operations.go
+++ b/script/interpreter/operations.go
@@ -1434,9 +1434,7 @@ func opcodeLShift(op *ParsedOpcode, t *thread) error {
 	if err != nil {
 		return err
 	}
-	n := num.Int()
-
-	if n < 0 {
+	if num.LessThanInt(0) {
 		return errs.NewError(errs.ErrNumberTooSmall, "n less than 0")
 	}
 
@@ -1445,6 +1443,14 @@ func opcodeLShift(op *ParsedOpcode, t *thread) error {
 		return err
 	}
 
+	// A count past every bit leaves zeros of the input's width. Compare before converting: Int() keeps only
+	// the low 64 bits, so a larger count would wrap (to a negative or a small shift).
+	if num.GreaterThanInt(int64(len(x)) * 8) {
+		t.dstack.PushByteArray(make([]byte, len(x)))
+		return nil
+	}
+	n := num.Int()
+
 	bitShift := n % 8
 	byteShift := n / 8
 	mask := []byte{0xFF, 0x7F, 0x3F, 0x1F, 0x0F, 0x07, 0x03, 0x01}[bitShift]
@@ -1476,9 +1482,7 @@ func opcodeRShift(op *ParsedOpcode, t *thread) error {
 	if err != nil {
 		return err
 	}
-	n := num.Int()
-
-	if n < 0 {
+	if num.LessThanInt(0) {
 		return errs.NewError(errs.ErrNumberTooSmall, "n less than 0")
 	}
 
@@ -1487,6 +1491,14 @@ func opcodeRShift(op *ParsedOpcode, t *thread) error {
 		return err
 	}
 
+	// A count past every bit leaves zeros of the input's width. Compare before converting: Int() keeps only
+	// the low 64 bits, so a larger count would wrap (to a negative or a small shift).
+	if num.GreaterThanInt(int64(len(x)) * 8) {
+		t.dstack.PushByteArray(make([]byte, len(x)))
+		return nil
+	}
+	n := num.Int()
+
 	byteShift := n / 8
 	bitShift := n % 8
 	mask := []byte{0xFF, 0xFE, 0xFC, 0xF8, 0xF0, 0xE0, 0xC0, 0x80}[bitShift]
@@ -2111,6 +2123,13 @@ func opcodeCheckMultiSig(op *ParsedOpcode, t *thread) error {
 		return err
 	}
 
+	// Range-check the full number before converting: Int() keeps only the low 64 bits and would wrap.
+	if numKeys.GreaterThanInt(int64(t.cfg.MaxPubKeysPerMultiSig())) {
+		return errs.NewError(errs.ErrInvalidPubKeyCount, "too many pubkeys: %s > %d", numKeys.Val, t.cfg.MaxPubKeysPerMultiSig())
+	}
+	if numKeys.LessThanInt(0) {
+		return errs.NewError(errs.ErrInvalidPubKeyCount, "number of pubkeys %s is negative", numKeys.Val)
+	}
 	numPubKeys := numKeys.Int()
 	if numPubKeys < 0 {
 		return errs.NewError(errs.ErrInvalidPubKeyCount, "number of pubkeys %d is negative", numPubKeys)
@@ -2141,6 +2160,12 @@ func opcodeCheckMultiSig(op *ParsedOpcode, t *thread) error {
 		return err
 	}
 
+	if numSigs.GreaterThanInt(int64(numPubKeys)) {
+		return errs.NewError(errs.ErrInvalidSignatureCount, "more signatures than pubkeys: %s > %d", numSigs.Val, numPubKeys)
+	}
+	if numSigs.LessThanInt(0) {
+		return errs.NewError(errs.ErrInvalidSignatureCount, "number of signatures %s is negative", numSigs.Val)
+	}
 	numSignatures := numSigs.Int()
 	if numSignatures < 0 {
 		return errs.NewError(errs.ErrInvalidSignatureCount, "number of signatures %d is negative", numSignatures)
diff --git a/script/interpreter/wide_count_test.go b/script/interpreter/wide_count_test.go
new file mode 100644
index 0000000..e40a571
--- /dev/null
+++ b/script/interpreter/wide_count_test.go
@@ -0,0 +1,49 @@
+// Copyright (c) 2024 The bsv-blockchain/go-sdk developers
+// Use of this source code is governed by an ISC license that can be found in the LICENSE file.
+
+package interpreter
+
+import (
+	"encoding/hex"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/bsv-blockchain/go-sdk/script"
+	"github.com/bsv-blockchain/go-sdk/transaction"
+)
+
+// A count wider than 64 bits must be judged by its full value, not by the low 64 bits ScriptNumber.Int keeps.
+func TestWideCountsAreNotTruncated(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		lock string
+		err  string // empty: valid
+	}{
+		// 2^64 + 1 shifts every bit out (the low 64 bits would shift by 1 and leave 0x0e)
+		{"OP_LSHIFT by 2^64+1 gives zeros", "0107" + "09010000000000000001" + "98" + "0100" + "87", ""},
+		// 2^63 is positive (the low 64 bits read as a negative int64)
+		{"OP_RSHIFT by 2^63 gives zeros", "0107" + "09000000000000008000" + "99" + "0100" + "87", ""},
+		// 2^64 keys is too many (the low 64 bits read as 0 keys)
+		{"OP_CHECKMULTISIG with 2^64 keys fails", "00" + "00" + "09000000000000000001" + "ae", "too many pubkeys"},
+	}
+	for _, tt := range tests {
+		tt := tt
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			b, err := hex.DecodeString(tt.lock)
+			require.NoError(t, err)
+			lock := script.Script(b)
+			tx := chronicleVersionTx()
+			prevOut := &transaction.TransactionOutput{LockingScript: &lock}
+			err = NewEngine().Execute(WithTx(tx, 0, prevOut), WithAfterGenesis(), WithAfterChronicle())
+			if tt.err == "" {
+				require.NoError(t, err)
+			} else {
+				require.ErrorContains(t, err, tt.err)
+			}
+		})
+	}
+}
