From 659356f6234a3619dd8594a50951251fccdaa0e7 Mon Sep 17 00:00:00 2001
From: Freddie Honohan <honohanf@gmail.com>
Date: Thu, 8 Oct 2026 19:29:54 +0100
Subject: [PATCH 2/7] Spend: execute OP_2MUL and OP_2DIV (multiply / divide the
 top number by 2), as ts-sdk Spend does

They were refused as disabled opcodes. Chronicle re-enabled them, and ts-sdk's
Spend (with no explicit verify flags) executes them; OP_2DIV truncates toward
zero. Found by b017-native's differential corpus: a b017 spend the TS reference
and go-sdk accept was refused here.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/script/spend.rs     | 18 ++++++++++--------
 src/script/spend_ops.rs |  8 +++++---
 2 files changed, 15 insertions(+), 11 deletions(-)

diff --git a/src/script/spend.rs b/src/script/spend.rs
index 8c36e39..7784806 100644
--- a/src/script/spend.rs
+++ b/src/script/spend.rs
@@ -1075,17 +1075,19 @@ mod tests {
     }
 
     #[test]
-    fn test_op_disabled_2mul() {
-        let mut spend = make_spend("OP_1", "OP_2MUL");
-        let result = spend.validate();
-        assert!(matches!(result, Err(ScriptError::DisabledOpcode(_))));
+    fn test_op_2mul() {
+        // 3 * 2 == 6
+        let mut spend = make_relaxed_spend("OP_3", "OP_2MUL OP_6 OP_EQUAL");
+        assert!(spend.validate().unwrap());
     }
 
     #[test]
-    fn test_op_disabled_2div() {
-        let mut spend = make_spend("OP_1", "OP_2DIV");
-        let result = spend.validate();
-        assert!(matches!(result, Err(ScriptError::DisabledOpcode(_))));
+    fn test_op_2div() {
+        // 7 / 2 == 3, and -7 / 2 == -3 (truncated toward zero)
+        let mut spend = make_relaxed_spend("OP_7", "OP_2DIV OP_3 OP_EQUAL");
+        assert!(spend.validate().unwrap());
+        let mut spend = make_relaxed_spend("87", "OP_2DIV 83 OP_EQUAL");
+        assert!(spend.validate().unwrap());
     }
 
     // =================================================================
diff --git a/src/script/spend_ops.rs b/src/script/spend_ops.rs
index f8c74e9..c2b19ba 100644
--- a/src/script/spend_ops.rs
+++ b/src/script/spend_ops.rs
@@ -802,13 +802,15 @@ impl Spend {
                 self.push_stack(result.to_script_num())?;
             }
 
-            // -- Disabled Opcodes -----------------------------------------------
+            // -- OP_2MUL / OP_2DIV (re-enabled by Chronicle) ----------------------
+            // ts-sdk `Spend` (with no explicit verify flags) executes both: the top number times 2, and the top
+            // number divided by 2 (truncated toward zero).
             Op::Op2Mul => {
-                return Err(ScriptError::DisabledOpcode("OP_2MUL".to_string()));
+                self.unary_arith_op(|a| a.mul(&BigNumber::from_number(2)))?;
             }
 
             Op::Op2Div => {
-                return Err(ScriptError::DisabledOpcode("OP_2DIV".to_string()));
+                self.unary_arith_op(|a| a.div(&BigNumber::from_number(2)).expect("division by 2"))?;
             }
 
             // -- All NOPs (NOP11..NOP77 etc) ------------------------------------
